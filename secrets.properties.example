# Secrets locais - Este arquivo é ignorado pelo git (NÃO commitar)
# Copie este arquivo para secrets.properties e preencha os valores

# Token do GitHub para reportar crashes e análises como Issues
# Gerar em: https://github.com/settings/tokens
# Permissões necessárias: repo (para criar Issues)
GITHUB_REPORTER_TOKEN=none

# Release signing (obrigatório para APK final assinado)
# Exemplo de caminho: C:\keystores\deepmule-release.jks
DEEPMULE_RELEASE_STORE_FILE=
DEEPMULE_RELEASE_STORE_PASSWORD=
DEEPMULE_RELEASE_KEY_ALIAS=
DEEPMULE_RELEASE_KEY_PASSWORD=

# Opcional: configuração para task buildAndInstallRelease
DEEPMULE_ADB_PATH=adb
DEEPMULE_DEVICE_SERIAL=

